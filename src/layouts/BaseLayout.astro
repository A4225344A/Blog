---
import ThemeInit from '../components/ThemeInit.astro';
import ThemeSelect from '../components/ThemeSelect.astro';
import Analytics from '../components/Analytics.astro';
import { buildMeasurementId } from '../lib/analytics/config';
import { locales, messages, type Locale } from '../i18n';
import { localePath } from '../utils/routes';
import '../styles/global.css';
import { sections, ui } from '../i18n/ui';
import { absoluteUrl, withBase } from '../utils/routes';
import { safeJson, websiteJsonLd } from '../utils/seo';
import Sidebar from '../components/Sidebar.astro';
import { siteConfig } from '../config/site';
import { getContentGraph } from '../utils/build-graph';
import ArticleTools from '../components/ArticleTools.astro';
import { publishedArticles, isCase } from '../utils/catalog';
interface Props { locale: Locale; title?: string; description?: string; languageLinks?: Partial<Record<Locale, string>>; alternates?: Partial<Record<Locale, string>>; jsonLd?: unknown; article?: boolean; search?: boolean; indexContent?: boolean; noindex?: boolean; sidebar?: boolean; showRecent?: boolean }
const { locale, title, description, languageLinks = {}, alternates = languageLinks, jsonLd, article = false, indexContent = false, sidebar = true, showRecent = true } = Astro.props;
const t = messages[locale];
const site = Astro.site?.href ?? 'http://localhost:4321';
const canonical = absoluteUrl(Astro.url.pathname, site);
const { graph } = await getContentGraph();
const hasCases = publishedArticles(graph.articles, locale).some(isCase);
const analyticsId = buildMeasurementId(import.meta.env.PROD, import.meta.env.PUBLIC_GA_MEASUREMENT_ID);
const equivalentLinks = Object.keys(alternates).length ? alternates : Object.fromEntries(locales.map(target => [target, localePath(target, '', import.meta.env.BASE_URL)]));
const isHomeCluster = [import.meta.env.BASE_URL, ...locales.map(target => localePath(target, '', import.meta.env.BASE_URL))].includes(Astro.url.pathname);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    {analyticsId && <Analytics id={analyticsId} canonical={canonical} />}
    <meta name="viewport" content="width=device-width" />
    <ThemeInit />
    {Astro.props.noindex && <meta name="robots" content="noindex,follow" />}
    <title>{title ?? t.title}</title>
    <meta name="author" content={siteConfig.author.name[locale]} />
    <meta property="og:site_name" content={t.title} />
    <meta name="description" content={description ?? t.tagline} />
    {!Astro.props.noindex && <link rel="canonical" href={canonical} />}
    {!Astro.props.noindex && Object.entries(equivalentLinks).map(([target, path]) => <link rel="alternate" hreflang={target} href={absoluteUrl(path, site)} />)}
    {isHomeCluster && <link rel="alternate" hreflang="x-default" href={absoluteUrl(import.meta.env.BASE_URL, site)} />}
    <meta property="og:title" content={title ?? t.title} />
    <meta property="og:description" content={description ?? t.tagline} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'zh-TW' ? 'zh_TW' : 'en_US'} />
    <meta property="og:image" content={absoluteUrl(withBase('images/social-card.png', import.meta.env.BASE_URL), site)} />
    <link rel="alternate" type="application/rss+xml" title={`${t.title} RSS`} href={withBase(`${locale === 'zh-TW' ? 'zh-tw' : 'en'}/rss.xml`, import.meta.env.BASE_URL)} />
    {jsonLd !== undefined && <script type="application/ld+json" set:html={safeJson(jsonLd)} />}
    {isHomeCluster && <script type="application/ld+json" set:html={safeJson(websiteJsonLd(site, import.meta.env.BASE_URL))} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-brand" href={localePath(locale, '', import.meta.env.BASE_URL)}><span class="brand-mark" aria-hidden="true">J</span>{t.title}</a>
        <nav class="site-nav" aria-label={ui[locale].explore}>
          {sections.filter(section => section !== 'cases' || hasCases).map(section => <a href={localePath(locale, section, import.meta.env.BASE_URL)} aria-current={Astro.url.pathname.startsWith(localePath(locale, section, import.meta.env.BASE_URL)) ? 'page' : undefined}>{ui[locale][section]}</a>)}
          <a href={localePath(locale, 'search', import.meta.env.BASE_URL)}>{ui[locale].search}</a>
        </nav>
        <nav class="lang-nav" aria-label={t.language}>
          {locales.map(target => <a href={languageLinks[target] ?? localePath(target, '', import.meta.env.BASE_URL)} lang={target} hreflang={target} aria-current={target === locale ? 'page' : undefined}>{target === 'zh-TW' ? '繁體中文' : 'English'}</a>)}
        </nav>
        <div class="theme-control"><ThemeSelect locale={locale} /></div>
      </div>
    </header>
    <slot name="banner" />
    <div class:list={['page', { 'has-sidebar': sidebar }]}>
      <main id="main" class:list={{ 'article-page': article }} tabindex="-1" data-pagefind-body={indexContent || undefined} data-pagefind-ignore={!indexContent || undefined}><slot /></main>
      {sidebar && <Sidebar locale={locale} showRecent={showRecent}><slot name="sidebar" /></Sidebar>}
    </div>
    <footer><div class="footer-inner"><p>© 2026 {siteConfig.author.name[locale]} · {locale === 'zh-TW' ? '全端工程師' : 'Full-stack engineer'}</p><a href={siteConfig.author.githubUrl}>GitHub ↗</a><a href={withBase(`${locale === 'zh-TW' ? 'zh-tw' : 'en'}/rss.xml`, import.meta.env.BASE_URL)}>RSS</a></div></footer>
    {article && <ArticleTools />}
  </body>
</html>
