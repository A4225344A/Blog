<script>
  const zh = document.documentElement.lang === 'zh-TW';
  const copyLabel = zh ? '複製程式碼' : 'Copy code';
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const code = pre.querySelector('code');
    if (!code) continue;
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    const toolbar = document.createElement('div');
    toolbar.className = 'code-toolbar';
    toolbar.setAttribute('data-pagefind-ignore', '');
    const status = document.createElement('span');
    status.setAttribute('role', 'status');
    const button = document.createElement('button');
    button.type = 'button';
    button.textContent = copyLabel;
    button.addEventListener('click', async () => {
      button.disabled = true;
      status.textContent = '';
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        status.textContent = zh ? '已複製' : 'Copied';
      } catch {
        status.textContent = zh ? '無法複製，請選取程式碼手動複製。' : 'Could not copy. Select the code and copy it manually.';
      } finally {
        button.disabled = false;
      }
    });
    pre.before(wrapper);
    toolbar.append(status, button);
    wrapper.append(toolbar, pre);
  }

  for (const svg of document.querySelectorAll<SVGSVGElement>('.prose .learning-diagram > svg')) {
    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.className = 'diagram-zoom';
    trigger.textContent = zh ? '放大流程圖' : 'Enlarge diagram';
    trigger.setAttribute('data-pagefind-ignore', '');
    const dialog = document.createElement('dialog');
    dialog.className = 'diagram-dialog';
    dialog.setAttribute('aria-label', svg.getAttribute('aria-label') ?? trigger.textContent);
    dialog.setAttribute('data-pagefind-ignore', '');
    const close = document.createElement('button');
    close.type = 'button';
    close.textContent = zh ? '關閉' : 'Close';
    close.autofocus = true;
    close.addEventListener('click', () => dialog.close());
    const viewport = document.createElement('div');
    viewport.className = 'diagram-viewport';
    viewport.tabIndex = 0;
    viewport.setAttribute('role', 'region');
    viewport.setAttribute('aria-label', zh ? '放大圖，可捲動' : 'Enlarged diagram, scrollable');
    const enlarged = svg.cloneNode(true);
    if (!(enlarged instanceof SVGSVGElement)) continue;
    enlarged.style.width = '640px';
    enlarged.style.maxWidth = 'none';
    viewport.append(enlarged);
    dialog.append(close, viewport);
    document.body.append(dialog);
    svg.after(trigger);
    trigger.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('close', () => trigger.focus());
  }
</script>

<style is:global>
  .code-block { margin: 1.5rem 0; min-width: 0; }
  .code-toolbar { display: flex; justify-content: flex-end; align-items: center; gap: .75rem; flex-wrap: wrap; font-size: .85rem; }
  .code-toolbar button, .diagram-zoom, .diagram-dialog button { font: inherit; padding: .4rem .8rem; color: var(--link); background: var(--surface); border: 1px solid var(--border); border-radius: .5rem; cursor: pointer; }
  .code-block pre { margin-top: .5rem; }
  .diagram-zoom { display: block; margin: 1rem auto 0; }
  .diagram-dialog { width: min(90vw, 720px); max-width: calc(100vw - 2rem); max-height: 90vh; padding: 1rem; color: var(--fg); background: var(--surface); border: 1px solid var(--border); border-radius: .75rem; }
  .diagram-dialog::backdrop { background: rgb(0 0 0 / .65); }
  .diagram-viewport { overflow: auto; max-height: 70vh; margin-top: .75rem; }
</style>
