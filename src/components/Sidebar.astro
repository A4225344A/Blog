---
import Author from './Author.astro';
import type { Locale } from '../i18n';
import { siteConfig } from '../config/site';
import { getContentGraph } from '../utils/build-graph';
import { publishedArticles, topicsWithArticles } from '../utils/catalog';
import { articlePath, localePath } from '../utils/routes';
interface Props { locale: Locale; showRecent?: boolean }
const { locale, showRecent = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const { graph } = await getContentGraph();
const articles = publishedArticles(graph.articles, locale);
const publicIds = new Set(articles.map(article => article.id));
const stats = [
  [locale === 'zh-TW' ? '文章' : 'Articles', articles.length, 'blog'],
  [locale === 'zh-TW' ? '主題' : 'Topics', topicsWithArticles(graph, locale).length, 'topics'],
  [locale === 'zh-TW' ? '系列' : 'Series', graph['learning-paths'].filter(path => path.sections.some(section => section.articleIds.some(id => publicIds.has(id)))).length, 'learn'],
] as const;
---
<aside class="sidebar" aria-label={locale === 'zh-TW' ? '側欄' : 'Sidebar'} data-pagefind-ignore>
  <section class="widget author-card">
    <Author locale={locale} />
    <ul class="stats">
      {stats.map(([label, value, section]) => <li><a href={localePath(locale, section, base)}><strong>{value}</strong><span>{label}</span></a></li>)}
    </ul>
    <a class="button block" href={siteConfig.author.githubUrl}>GitHub</a>
  </section>
  <slot />
  {showRecent && <section class="widget">
    <h2 class="widget-title">{locale === 'zh-TW' ? '最新文章' : 'Recent posts'}</h2>
    <ul class="recent">
      {articles.slice(0, 5).map(article => <li><a href={articlePath(article, base)}>{article.title}</a>{article.publishedAt && <time datetime={article.publishedAt.toISOString()}>{article.publishedAt.toISOString().slice(0, 10)}</time>}</li>)}
    </ul>
  </section>}
</aside>
