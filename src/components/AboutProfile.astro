---
import Author from './Author.astro';
import type { Locale } from '../i18n';
import { localePath } from '../utils/routes';
import { siteConfig } from '../config/site';
interface Props { locale: Locale; articleCount: number; hasCases: boolean }
const { locale, articleCount, hasCases } = Astro.props;
const copy = {
  'zh-TW': {
    greeting: `嗨，我是 ${siteConfig.author.name}，一名全端工程師`,
    title: '從全端開發，走向雲原生與平台工程',
    intro: '我寫 C#、Angular 和 React，也想弄懂程式上線後怎麼運作。這裡先從 Astro 部落格的建置過程寫起。',
    count: '篇已發布文章', countNote: '繁體中文內容',
    background: '關於我',
    backgroundText: '我的開發背景是全端，接下來想把學習重心延伸到部署與維運。雲原生和平台工程是目前正在學的方向。',
    motivation: '接下來的學習方向：雲原生',
    motivationText: '功能能跑之後，還有部署、監控和故障處理要做。我想知道，服務出問題時該先看哪些訊號，以及哪些操作可以交給自動化。這也是我開始學雲原生的原因。',
    exploring: '現在在探索什麼',
    explorations: [
      ['Kubernetes', '把應用放進容器後，怎麼部署和管理。'],
      ['GitOps', '把部署設定放進 Git，追蹤每次修改。'],
      ['Observability', '用指標、日誌和追蹤資料找出系統出了什麼事。'],
      ['AWS', '了解部署應用需要哪些雲端資源。'],
      ['SRE', '學習衡量服務可靠性，減少反覆手動處理的工作。'],
      ['AI Engineering', '把 AI 接進應用，並檢查結果是否可靠。'],
    ],
    purpose: '為什麼寫這個部落格',
    purposeText: '寫下來，是為了下次需要時找得到。我會把設定方法和選擇的原因放在一起，希望碰到相同問題時，能少花一點摸索的時間。現在的四篇文章都在談 Astro：從建立專案到部署，再到雙語文章的整理方式。',
    start: '從哪裡開始',
    entries: [
      ['learn', '文章系列', '照順序完成 Astro 部落格。'],
      ['projects', '專案', '看看 AI SRE Platform 的實驗方向。'],
      ['cases', '排障案例', '從問題現象一路看到修正方法。'],
      ['blog', '技術文章', '挑一篇感興趣的文章開始。'],
    ],
  },
  en: {
    greeting: `Hi, I’m ${siteConfig.author.name}, a full-stack engineer`,
    title: 'From full-stack development to cloud native and platform engineering',
    intro: 'I write C#, Angular and React, and I want to understand what happens after the code goes live. The first articles here cover building this Astro blog.',
    count: 'published articles', countNote: 'English content',
    background: 'About me',
    backgroundText: 'My background is in full-stack development. I’m extending that into deployment and operations, with cloud native and platform engineering as my current areas of study.',
    motivation: 'Learning direction: cloud native',
    motivationText: 'Once a feature works, there is still deployment, monitoring and fault handling to think about. I want to know which signals to check when a service fails and which manual tasks can be automated. That is what draws me to cloud native.',
    exploring: 'What I’m exploring now',
    explorations: [
      ['Kubernetes', 'Learning how to deploy and manage applications in containers.'],
      ['GitOps', 'Keeping deployment settings in Git to track each change.'],
      ['Observability', 'Using metrics, logs and traces to find out what happened.'],
      ['AWS', 'Understanding which cloud resources an application needs.'],
      ['SRE', 'Learning to measure service reliability and reduce repeated manual work.'],
      ['AI Engineering', 'Adding AI to applications and checking whether the results are reliable.'],
    ],
    purpose: 'Why I write this blog',
    purposeText: 'I write things down so I can find them again. I keep the setup steps alongside the reasons for choosing them, in the hope that they save some searching next time. The four articles so far cover Astro, from creating the project to deployment and organizing translations.',
    start: 'Where to start',
    entries: [
      ['learn', 'Article series', 'Build an Astro blog step by step.'],
      ['projects', 'Projects', 'See the ideas behind the AI SRE Platform lab.'],
      ['cases', 'Case studies', 'Follow a problem from symptoms to a fix.'],
      ['blog', 'Articles', 'Pick an article that interests you.'],
    ],
  },
} as const;
const t = copy[locale];
---
<div class="about-profile">
  <div class="profile-intro">
    <div><p class="eyebrow">{t.greeting}</p><h1>{t.title}</h1><p class="lead">{t.intro}</p></div>
    <aside class="profile-author"><Author locale={locale} /></aside>
  </div>
  <div class="publication-count"><strong>{articleCount}</strong><div><span>{t.count}</span><small>{t.countNote}</small></div></div>
  <section><h2>{t.purpose}</h2><p>{t.purposeText}</p></section>
  <section><h2>{t.background}</h2><p>{t.backgroundText}</p><ul class="labels" aria-label={locale === 'zh-TW' ? '開發技術' : 'Development tools'}>{['C#', 'Angular', 'React'].map(tool => <li>{tool}</li>)}</ul></section>
  <section><h2>{t.motivation}</h2><p>{t.motivationText}</p></section>
  <section><h2>{t.exploring}</h2><dl class="explorations">{t.explorations.map(([name, description]) => <div><dt>{name}</dt><dd>{description}</dd></div>)}</dl></section>
  <section><h2>{t.start}</h2><ul class="entry-links">{t.entries.filter(([path]) => path !== 'cases' || hasCases).map(([path, label, description]) => <li><a href={localePath(locale, path, import.meta.env.BASE_URL)}>{label}<span aria-hidden="true"> ↗</span></a><p>{description}</p></li>)}</ul></section>
</div>
<style>
  .about-profile { max-width: 64rem; margin-inline: auto; }
  .profile-intro { display: grid; grid-template-columns: minmax(0, 1fr) 13rem; gap: 3rem; align-items: center; }
  h1 { font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.35; max-width: 24ch; }
  p { line-height: 1.9; max-width: 70ch; }
  .profile-author { padding: 1.5rem; background: var(--soft); border-radius: .75rem; }
  .publication-count { display: flex; align-items: center; gap: 1.25rem; padding: 1.25rem 0; margin-top: 2rem; border-block: 1px solid var(--border); }
  .publication-count strong { font-size: 2.5rem; line-height: 1.2; }
  .publication-count small { display: block; color: var(--muted); }
  .labels { display: flex; flex-wrap: wrap; gap: .6rem; padding: 0; list-style: none; }
  .labels li { background: var(--soft); padding: .3rem .8rem; border-radius: .35rem; font-size: .9rem; }
  .explorations, .entry-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 2rem; }
  .explorations > div, .entry-links li { border-top: 1px solid var(--border); padding-top: 1rem; }
  dt, .entry-links a { font-size: 1.1rem; font-weight: 650; }
  dd { margin: .5rem 0 0; color: var(--muted); line-height: 1.8; }
  .entry-links { list-style: none; padding: 0; }
  .entry-links p { margin-bottom: 0; color: var(--muted); font-size: .95rem; }
  @media (max-width: 48rem) { .profile-intro { grid-template-columns: 1fr; gap: 1rem; } .explorations, .entry-links { grid-template-columns: 1fr; } }
</style>
