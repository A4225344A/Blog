---
import type { Article } from '../content/schemas';
import type { Locale } from '../i18n';
import { ui } from '../i18n/ui';
import { articlePath } from '../utils/routes';
interface Props { articles: Article[]; locale: Locale; ordered?: boolean }
const { articles, locale, ordered = false } = Astro.props;
const List = ordered ? 'ol' : 'ul';
---
{articles.length ? <List class="cards article-list">
  {articles.map(article => <li class="post-card"><p class="post-card-meta">{article.publishedAt && <time datetime={article.publishedAt.toISOString()}>{article.publishedAt.toISOString().slice(0, 10)}</time>}</p><a href={articlePath(article, import.meta.env.BASE_URL)}>{article.title}</a><p>{article.description}</p></li>)}
</List> : <p class="muted">{ui[locale].empty}</p>}
