---
import type { Locale } from '../i18n';
import { siteConfig } from '../config/site';
import { withBase } from '../utils/routes';
interface Props { locale: Locale; compact?: boolean }
const { locale, compact = false } = Astro.props;
const author = siteConfig.author;
const name = author.name[locale];
---
<div class:list={['author', { compact }]}>
  <a class="avatar-link" href={author.githubUrl} aria-label={locale === 'zh-TW' ? `${name} 的 GitHub` : `${name} on GitHub`}>
    <img src={withBase(author.avatar, import.meta.env.BASE_URL)} alt={name} width="96" height="96" />
  </a>
  <div><a class="author-name" href={author.githubUrl}>{name}</a><p>{author.tagline[locale]}</p></div>
</div>
