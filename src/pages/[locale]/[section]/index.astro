---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopicFilter from '../../../components/TopicFilter.astro';
import ArticleList from '../../../components/ArticleList.astro';
import EntityList from '../../../components/EntityList.astro';
import AboutProfile from '../../../components/AboutProfile.astro';
import { locales, localePrefix, type Locale } from '../../../i18n';
import { ui, sections, sectionDescriptions, type Section } from '../../../i18n/ui';
import { getContentGraph } from '../../../utils/build-graph';
import { publishedArticles, isCase, topicsWithArticles } from '../../../utils/catalog';
import { localePath } from '../../../utils/routes';
import { aboutJsonLd } from '../../../utils/seo';
import { siteConfig } from '../../../config/site';
export function getStaticPaths() {
  return locales.flatMap(locale => sections.map(section => ({ params: { locale: localePrefix[locale], section }, props: { locale, section } })));
}
interface Props { locale: Locale; section: Section }
const { locale, section } = Astro.props;
const t = ui[locale];
const { graph } = await getContentGraph();
const articles = publishedArticles(graph.articles, locale);
const languageLinks = Object.fromEntries(locales.map(target => [target, localePath(target, section, import.meta.env.BASE_URL)]));
---
<BaseLayout locale={locale} sidebar={section !== 'about'} indexContent={section === 'about'} jsonLd={section === 'about' ? aboutJsonLd(locale, Astro.site?.href ?? 'http://localhost:4321', import.meta.env.BASE_URL) : undefined} title={section === 'about' ? `${t.about} ${siteConfig.author.name[locale]}` : t[section]} description={sectionDescriptions[locale][section]} languageLinks={languageLinks}>
  {section !== 'about' && <h1>{t[section]}</h1>}
  {section === 'start' && <>
    <p class="lead">{t.startIntro}</p>
    <section aria-labelledby="blog-entry"><h2 id="blog-entry">{t.blogEntry}</h2><p>{t.blogIntro}</p><EntityList entries={graph['learning-paths'].filter(path => path.id === siteConfig.startLearningPathIds.blog)} section="learn" locale={locale} /></section>
    <section aria-labelledby="explore-entry"><h2 id="explore-entry">{t.exploreEntry}</h2><p>{t.exploreIntro}</p><p><a href={localePath(locale, 'projects', import.meta.env.BASE_URL)}>{t.projects}</a> · <a href={localePath(locale, 'blog', import.meta.env.BASE_URL)}>{t.blog}</a> · <a href={localePath(locale, 'about', import.meta.env.BASE_URL)}>{t.about}</a></p></section>
    <h2>{t.topics}</h2><EntityList entries={topicsWithArticles(graph, locale)} section="topics" locale={locale} />
  </>}
  {section === 'learn' && <EntityList entries={graph['learning-paths']} section="learn" locale={locale} />}
  {section === 'topics' && <EntityList entries={topicsWithArticles(graph, locale)} section="topics" locale={locale} />}
  {section === 'projects' && <EntityList entries={graph.projects} section="projects" locale={locale} />}
  {section === 'blog' && <><TopicFilter locale={locale} graph={graph} /><p>{locale === 'zh-TW' ? '最新發布的文章排在前面。想照順序閱讀，可以點卡片上的系列名稱。' : 'Newest articles appear first. Follow a series link on a card to read it in order.'}</p><ArticleList articles={articles.filter(a => !isCase(a))} locale={locale} details graph={graph} /></>}
  {section === 'cases' && <ArticleList articles={articles.filter(isCase)} locale={locale} />}
  {section === 'about' && <AboutProfile locale={locale} articleCount={articles.length} hasCases={articles.some(isCase)} />}
</BaseLayout>
