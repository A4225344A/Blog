---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleList from '../../../components/ArticleList.astro';
import EntityList from '../../../components/EntityList.astro';
import { locales, localePrefix, type Locale } from '../../../i18n';
import { ui, maturityLabels } from '../../../i18n/ui';
import { entityText, sectionText, pathAudience } from '../../../i18n/content';
import { getContentGraph } from '../../../utils/build-graph';
import { isCase, orderedPathArticles, publishedArticles, pathArticleNavigation } from '../../../utils/catalog';
import { localePath, translatedArticlePath } from '../../../utils/routes';
import { articlePath } from '../../../utils/routes';
import { articleJsonLd } from '../../../utils/seo';
export async function getStaticPaths() {
  const { graph } = await getContentGraph();
  const paths = publishedArticles(graph.articles).map(article => ({ params: { locale: localePrefix[article.locale], section: isCase(article) ? 'cases' : 'blog', slug: article.slug }, props: { locale: article.locale, kind: 'article', id: article.id } }));
  for (const locale of locales) for (const [kind, entries] of [['topics', graph.topics], ['learn', graph['learning-paths']], ['projects', graph.projects]] as const)
    for (const entry of entries) paths.push({ params: { locale: localePrefix[locale], section: kind, slug: entry.id }, props: { locale, kind, id: entry.id } });
  return paths;
}
interface Props { locale: Locale; kind: string; id: string }
const { locale, kind, id } = Astro.props;
const { graph, reverse } = await getContentGraph();
const t = ui[locale];
const article = kind === 'article' ? graph.articles.find(a => a.id === id) : undefined;
const topic = kind === 'topics' ? graph.topics.find(a => a.id === id) : undefined;
const path = kind === 'learn' ? graph['learning-paths'].find(a => a.id === id) : undefined;
const project = kind === 'projects' ? graph.projects.find(a => a.id === id) : undefined;
const entity = article ?? topic ?? path ?? project;
if (!entity) throw new Error(`Missing entity ${id}`);
const text = article ? { title: article.title, description: article.description } : entityText(topic ? 'topics' : path ? 'learning-paths' : 'projects', entity, locale);
const entry = article ? (await getCollection('articles')).find(a => a.id === id) : undefined;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const articles = publishedArticles(graph.articles, locale);
const base = import.meta.env.BASE_URL;
const languageLinks = Object.fromEntries(locales.map(target => [target, article ? translatedArticlePath(article, target, graph.articles, base) : localePath(target, `${kind}/${encodeURIComponent(id)}`, base)]));
const articleReverse = reverse.articles.get(id);
const searchTerms = article ? [
  ...graph.topics.filter(topic => article.topics.includes(topic.id)).map(topic => entityText('topics', topic, locale).title),
  ...graph.skills.filter(skill => article.skills.includes(skill.id) || article.prerequisiteSkills.includes(skill.id)).map(skill => entityText('skills', skill, locale).title),
].join(' · ') : undefined;
const alternates = article ? Object.fromEntries(publishedArticles(graph.articles).filter(a => a.translationKey === article.translationKey).map(a => [a.locale, articlePath(a, base)])) : languageLinks;
---
<BaseLayout locale={locale} indexContent title={text.title} description={text.description} languageLinks={languageLinks} alternates={alternates} article={Boolean(article)} jsonLd={article ? articleJsonLd(article, Astro.site?.href ?? 'http://localhost:4321', base) : undefined}>
  <article data-search-terms={searchTerms} data-pagefind-index-attrs={article ? 'data-search-terms' : undefined}>
    <h1 data-pagefind-meta="title">{text.title}</h1><p class="lead" data-pagefind-meta="description">{text.description}</p>
    {article && <>
      {article.publishedAt && <p>{t.published}: <time datetime={article.publishedAt.toISOString()}>{article.publishedAt.toISOString().slice(0, 10)}</time></p>}
      {article.updatedAt && <p>{t.updated}: <time datetime={article.updatedAt.toISOString()}>{article.updatedAt.toISOString().slice(0, 10)}</time></p>}
      {rendered && rendered.headings.length > 0 && <nav class="toc" aria-label={t.contents}><h2>{t.contents}</h2><ul>{rendered.headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>}
      {Content && <div class="prose"><Content /></div>}
      {graph['learning-paths'].filter(path => articleReverse?.learningPathIds.includes(path.id)).map(path => {
        const adjacent = pathArticleNavigation(path, graph.articles, locale, id);
        return adjacent && (adjacent.previous || adjacent.next) && <nav class="toc" aria-label={`${t.pathNavigation}: ${entityText('learning-paths', path, locale).title}`}>
          <h2>{t.pathNavigation}</h2>
          <p><a href={localePath(locale, `learn/${encodeURIComponent(path.id)}`, base)}>{t.pathOverview}: {entityText('learning-paths', path, locale).title}</a></p>
          <ul>
            {adjacent.previous && <li><a href={articlePath(adjacent.previous, base)}>{t.previousLesson}: {adjacent.previous.title}</a></li>}
            {adjacent.next && <li><a href={articlePath(adjacent.next, base)}>{t.nextLesson}: {adjacent.next.title}</a></li>}
          </ul>
        </nav>;
      })}
      {articles.some(a => article.recommendedArticles.includes(a.id)) && <section><h2>{t.recommended}</h2><ArticleList articles={articles.filter(a => article.recommendedArticles.includes(a.id))} locale={locale} /></section>}
      {articleReverse?.projectIds.length ? <section><h2>{t.projects}</h2><EntityList entries={graph.projects.filter(p => articleReverse?.projectIds.includes(p.id))} section="projects" locale={locale} /></section> : null}
    </>}
    {topic && <ArticleList articles={articles.filter(a => a.topics.includes(topic.id))} locale={locale} />}
    {path && <>{path.targetAudience.length > 0 && <p>{t.audience}: {pathAudience(path, locale).join(' · ')}</p>}{orderedPathArticles(path, graph.articles, locale).map(section => <section><h2>{sectionText(path.id, section, locale).title}</h2><p>{sectionText(path.id, section, locale).description}</p><ArticleList articles={section.articles} locale={locale} ordered /></section>)}</>}
    {project && <><p>{t.maturity}: {maturityLabels[locale][project.maturity]}</p>{project.repositoryUrl && <a href={project.repositoryUrl}>{t.repository}</a>}<h2>{t.skills}</h2><ul>{graph.skills.filter(s => project.featuredSkills.includes(s.id)).map(s => <li>{entityText('skills', s, locale).title}</li>)}</ul>{articles.some(a => project.relatedArticles.includes(a.id)) && <><h2>{t.related}</h2><ArticleList articles={articles.filter(a => project.relatedArticles.includes(a.id))} locale={locale} /></>}{project.relatedLearningPaths.length > 0 && <><h2>{t.paths}</h2><EntityList entries={graph['learning-paths'].filter(p => project.relatedLearningPaths.includes(p.id))} section="learn" locale={locale} /></>}</>}
  </article>
</BaseLayout>
