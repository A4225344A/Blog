---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopicFilter from '../../../components/TopicFilter.astro';
import ArticleList from '../../../components/ArticleList.astro';
import EntityList from '../../../components/EntityList.astro';
import { locales, localePrefix, type Locale } from '../../../i18n';
import { ui, maturityLabels } from '../../../i18n/ui';
import { entityText, sectionText, pathAudience } from '../../../i18n/content';
import { getContentGraph } from '../../../utils/build-graph';
import { isCase, orderedPathArticles, publishedArticles, pathArticleNavigation, readingOrder } from '../../../utils/catalog';
import { localePath, translatedArticlePath } from '../../../utils/routes';
import { articlePath } from '../../../utils/routes';
import { articleJsonLd } from '../../../utils/seo';
import { siteConfig } from '../../../config/site';
import { legacyContentRoutes } from '../../../config/legacy-routes';
export async function getStaticPaths() {
  const { graph } = await getContentGraph();
  const paths = publishedArticles(graph.articles).map(article => ({ params: { locale: localePrefix[article.locale], section: isCase(article) ? 'cases' : 'blog', slug: article.slug }, props: { locale: article.locale, kind: 'article', id: article.id } }));
  for (const locale of locales) for (const [kind, entries] of [['topics', graph.topics], ['learn', graph['learning-paths']], ['projects', graph.projects]] as const)
    for (const entry of entries) paths.push({ params: { locale: localePrefix[locale], section: kind, slug: entry.id }, props: { locale, kind, id: entry.id } });
  for (const locale of locales) for (const route of legacyContentRoutes) {
    const [section, slug] = route.from.split('/');
    paths.push({ params: { locale: localePrefix[locale], section: section!, slug: slug! }, props: { locale, kind: 'legacy', id: route.from } });
  }
  return paths;
}
interface Props { locale: Locale; kind: string; id: string }
const { locale, kind, id } = Astro.props;
const { graph, reverse } = await getContentGraph();
const t = ui[locale];
const separator = locale === 'zh-TW' ? '：' : ': ';
const article = kind === 'article' ? graph.articles.find(a => a.id === id) : undefined;
const topic = kind === 'topics' ? graph.topics.find(a => a.id === id) : undefined;
const path = kind === 'learn' ? graph['learning-paths'].find(a => a.id === id) : undefined;
const project = kind === 'projects' ? graph.projects.find(a => a.id === id) : undefined;
const entity = article ?? topic ?? path ?? project;
const legacy = kind === 'legacy' ? legacyContentRoutes.find(route => route.from === id) : undefined;
if (!entity && !legacy) throw new Error(`Missing entity ${id}`);
const text = legacy ? {
  title: locale === 'zh-TW' ? '這份內容已改版' : 'This content has been revised',
  description: legacy.continuation
    ? (locale === 'zh-TW' ? '原本的文章已拆成兩篇：先加入文章與共用版型，再部署到 GitHub Pages。可以依目前進度選擇下方連結。' : 'This article is now two posts: first add an article and shared layout, then deploy to GitHub Pages. Choose the link that matches your progress.')
    : (locale === 'zh-TW' ? '這個網址原本是新手教學，現在已重寫為 Astro 部落格系列。新版需要基本 HTML 與程式經驗，可以從下方連結前往。' : 'This URL used to host a beginner tutorial. It has been rewritten as part of the Astro blog series, which assumes basic HTML and programming experience. Follow the link below for the new version.'),
} : article ? { title: article.title, description: article.description } : entityText(topic ? 'topics' : path ? 'learning-paths' : 'projects', entity!, locale);
const entry = article ? (await getCollection('articles')).find(a => a.id === id) : undefined;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const articles = publishedArticles(graph.articles, locale);
const noindex = Boolean(legacy || (topic && !articles.some(article => article.topics.includes(topic.id))));
const base = import.meta.env.BASE_URL;
const languageLinks = Object.fromEntries(locales.map(target => [target, article ? translatedArticlePath(article, target, graph.articles, base) : localePath(target, `${kind}/${encodeURIComponent(id)}`, base)]));
const articleReverse = reverse.articles.get(id);
const tocHeadings = rendered?.headings.filter(heading => heading.depth === 2) ?? [];
const searchTerms = article ? [
  ...graph.topics.filter(topic => article.topics.includes(topic.id)).map(topic => entityText('topics', topic, locale).title),
  ...graph.skills.filter(skill => article.skills.includes(skill.id) || article.prerequisiteSkills.includes(skill.id)).map(skill => entityText('skills', skill, locale).title),
].join(' · ') : undefined;
const alternates = article ? Object.fromEntries(publishedArticles(graph.articles).filter(a => a.translationKey === article.translationKey).map(a => [a.locale, articlePath(a, base)])) : topic ? Object.fromEntries(locales.filter(target => publishedArticles(graph.articles, target).some(article => article.topics.includes(topic.id))).map(target => [target, languageLinks[target]])) : languageLinks;
---
<BaseLayout locale={locale} indexContent={!noindex} noindex={noindex} title={text.title} description={text.description} languageLinks={legacy ? Object.fromEntries(locales.map(target => [target, localePath(target, legacy.from, base)])) : languageLinks} alternates={alternates} article={Boolean(article)} jsonLd={article ? articleJsonLd(article, Astro.site?.href ?? 'http://localhost:4321', base) : undefined}>
  <article data-search-terms={searchTerms} data-pagefind-index-attrs={article ? 'data-search-terms' : undefined}>
    <h1 data-pagefind-meta="title">{text.title}</h1><p class="lead" data-pagefind-meta="description">{text.description}</p>
    {legacy && <p><a href={localePath(locale, legacy.to, base)}>{legacy.continuation ? (locale === 'zh-TW' ? '加入文章與共用版型' : 'Adding articles and a shared layout') : (locale === 'zh-TW' ? '閱讀新版內容' : 'Read the revised content')}</a></p>}
    {legacy?.continuation && <p><a href={localePath(locale, legacy.continuation, base)}>{locale === 'zh-TW' ? '部署 Astro 部落格到 GitHub Pages' : 'Deploying an Astro blog to GitHub Pages'}</a></p>}
    {article && <>
      <p class="byline">{locale === 'zh-TW' ? '作者：' : 'By '}<a rel="author" href={localePath(locale, 'about', base)}>{siteConfig.author.name[locale]}</a></p>
      <p class="post-meta">{article.publishedAt && <span>{t.published}{separator}<time datetime={article.publishedAt.toISOString()}>{article.publishedAt.toISOString().slice(0, 10)}</time></span>}{article.updatedAt && <span>{t.updated}{separator}<time datetime={article.updatedAt.toISOString()}>{article.updatedAt.toISOString().slice(0, 10)}</time></span>}{graph.topics.filter(topic => article.topics.includes(topic.id)).map(topic => <a class="chip" href={localePath(locale, `topics/${encodeURIComponent(topic.id)}`, base)}>{entityText('topics', topic, locale).title}</a>)}</p>
      {tocHeadings.length > 0 && <nav class="mobile-toc" aria-label={t.contents} data-pagefind-ignore><h2>{t.contents}</h2><ol>{tocHeadings.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>}
      {Content && <div class="prose"><Content /></div>}
      {graph['learning-paths'].filter(path => articleReverse?.learningPathIds.includes(path.id)).map(path => {
        const adjacent = pathArticleNavigation(path, graph.articles, locale, id);
        return adjacent && (adjacent.previous || adjacent.next) && <nav class="series-nav" aria-label={`${t.pathNavigation}${separator}${entityText('learning-paths', path, locale).title}`}>
          <h2>{t.pathNavigation}</h2>
          <p><a href={localePath(locale, `learn/${encodeURIComponent(path.id)}`, base)}>{t.pathOverview}{separator}{entityText('learning-paths', path, locale).title}</a></p>
          <ul>
            {adjacent.previous && <li><a href={articlePath(adjacent.previous, base)}>{t.previousLesson}{separator}{adjacent.previous.title}</a></li>}
            {adjacent.next && <li><a href={articlePath(adjacent.next, base)}>{t.nextLesson}{separator}{adjacent.next.title}</a></li>}
          </ul>
        </nav>;
      })}
      {articles.some(a => article.recommendedArticles.includes(a.id)) && <section><h2>{t.recommended}</h2><ArticleList articles={articles.filter(a => article.recommendedArticles.includes(a.id))} locale={locale} /></section>}
      {articleReverse?.projectIds.length ? <section><h2>{t.projects}</h2><EntityList entries={graph.projects.filter(p => articleReverse?.projectIds.includes(p.id))} section="projects" locale={locale} /></section> : null}
    </>}
    {topic && <><TopicFilter locale={locale} selected={topic.id} graph={graph} /><p>{locale === 'zh-TW' ? '依系列閱讀順序排列，篇次以完整系列為準。' : 'Listed in series reading order; part numbers refer to the full series.'}</p><ArticleList articles={readingOrder(articles.filter(a => a.topics.includes(topic.id)), graph['learning-paths'], locale)} locale={locale} details graph={graph} /></>}
    {topic && noindex && <p>{locale === 'zh-TW' ? '這個主題還在學習與整理中，目前已發布的是 Astro 部落格系列。' : 'I’m still learning and gathering notes on this topic. The published articles currently cover building an Astro blog.'} <a href={localePath(locale, 'learn/knowledge-platform', base)}>{locale === 'zh-TW' ? '閱讀 Astro 系列' : 'Read the Astro series'}</a></p>}
    {path && <>{path.targetAudience.length > 0 && <p>{t.audience}{separator}{pathAudience(path, locale).join(' · ')}</p>}{orderedPathArticles(path, graph.articles, locale).map(section => <section><h2>{sectionText(path.id, section, locale).title}</h2><p>{sectionText(path.id, section, locale).description}</p><ArticleList articles={section.articles} locale={locale} ordered /></section>)}</>}
    {project && <><p>{t.maturity}{separator}{maturityLabels[locale][project.maturity]}</p>{project.repositoryUrl && <a href={project.repositoryUrl}>{t.repository}</a>}<h2>{t.skills}</h2><ul>{graph.skills.filter(s => project.featuredSkills.includes(s.id)).map(s => <li>{entityText('skills', s, locale).title}</li>)}</ul>{articles.some(a => project.relatedArticles.includes(a.id)) && <><h2>{t.related}</h2><ArticleList articles={articles.filter(a => project.relatedArticles.includes(a.id))} locale={locale} /></>}{project.relatedLearningPaths.length > 0 && <><h2>{t.paths}</h2><EntityList entries={graph['learning-paths'].filter(p => project.relatedLearningPaths.includes(p.id))} section="learn" locale={locale} /></>}</>}
  </article>
  {tocHeadings.length > 0 && <nav slot="sidebar" class="widget toc" aria-label={t.contents}><h2 class="widget-title">{t.contents}</h2><ol>{tocHeadings.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></nav>}
</BaseLayout>
