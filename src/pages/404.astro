---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath } from '../utils/routes';
const base = import.meta.env.BASE_URL;
---
<BaseLayout locale="zh-TW" title="404 — 找不到頁面 / Page not found" noindex sidebar={false}>
  <h1>404 — 找不到頁面 <span lang="en">/ Page not found</span></h1>
  <section lang="zh-TW" aria-labelledby="recovery-zh">
    <h2 id="recovery-zh">換個地方找找</h2>
    <p>這個網址沒有對應的頁面。可以搜尋文章，或從閱讀指南開始。</p>
    <ul>
      <li><a href={localePath('zh-TW', 'search', base)}>搜尋</a></li>
      <li><a href={localePath('zh-TW', 'start', base)}>閱讀指南</a></li>
      <li><a href={localePath('zh-TW', 'blog', base)}>技術文章</a></li>
    </ul>
  </section>
  <section lang="en" aria-labelledby="recovery-en">
    <h2 id="recovery-en">Find your way back</h2>
    <p>There is no page at this address. Search for an article or start with the reading guide.</p>
    <ul>
      <li><a href={localePath('en', 'search', base)}>Search</a></li>
      <li><a href={localePath('en', 'start', base)}>Reading guide</a></li>
      <li><a href={localePath('en', 'blog', base)}>Articles</a></li>
    </ul>
  </section>
</BaseLayout>
