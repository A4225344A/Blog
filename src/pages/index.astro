---
import BaseLayout from '../layouts/BaseLayout.astro';
import { messages } from '../i18n';
import { localePath } from '../utils/routes';
---
<BaseLayout locale="zh-TW">
  <h1>{messages['zh-TW'].title}</h1>
  <p>選擇閱讀語言 / <span lang="en">Choose your language</span></p>
  <p><a href={localePath('zh-TW', '', import.meta.env.BASE_URL)}>繁體中文</a> · <a lang="en" href={localePath('en', '', import.meta.env.BASE_URL)}>English</a></p>
</BaseLayout>
