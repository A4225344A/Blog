  <p>記錄個人專案、全端實作與架構取捨。</p>
  <p><a href={localePath('zh-TW', '', import.meta.env.BASE_URL)}>繁體中文</a> · <a href={localePath('en', '', import.meta.env.BASE_URL)}>English</a></p>
</BaseLayout>
